{
  "_help": [
    "Colour palettes for population_cartogram.py.",
    "Every palette has a 'light' and a 'dark' version. Each version has:",
    "  background: the sea (in light mode drawn as squares with a grid, in dark mode plain)",
    "  box_text, box_fill: text and background of the title box and the small-countries box",
    "  countries: 4 to 16 colours for the countries (neighbours get the most different ones)",
    "Optional, for --color-by: sequential (3+ colours, low to high) and diverging (an odd number",
    "of colours: decline ... no change ... growth). Without them built-in ramps are used.",
    "'default' is the palette used when --palette is not given.",
    "Check a palette with: python3 population_cartogram.py --list-palettes"
  ],
  "default": "classic",
  "palettes": {
    "classic": {
      "description": "Vivid colours on light blue (2015 style) / muted colours on slate (2018 style)",
      "light": {
        "background": "#c6e9f2", "box_text": "#13232b", "box_fill": "#eef8fb",
        "countries": ["#e41a1c", "#ff7f00", "#ffd92f", "#1a9641", "#1f4fe0", "#7b3fbf",
                      "#e7298a", "#8c1c13", "#f4a6c4", "#0d8a8a", "#a65628", "#222222"]
      },
      "dark": {
        "background": "#343f50", "box_text": "#f1f3f6", "box_fill": "#273040",
        "countries": ["#e5736f", "#f2a541", "#f1d65c", "#4fae6e", "#3f86d4", "#9f6fd0",
